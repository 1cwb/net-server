#!/bin/sh
### BEGIN INIT INFO
# Provides:          app_center
# Required-Start:
# Required-Stop:
# Default-Start:     S
# Default-Stop:
# Short-Description: app_center service
### END INIT INFO

DAEMON=/usr/bin/app_center
PID_FILE=/var/run/app_center.pid

start()
{
	[ -x "$DAEMON" ] || return 0
	start-stop-daemon -S -q -b -m -p "$PID_FILE" -x "$DAEMON"
}

stop()
{
	start-stop-daemon -K -q -p "$PID_FILE"
	rm -f "$PID_FILE"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
